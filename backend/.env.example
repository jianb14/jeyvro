# JEYVRO backend environment template — copy to .env and fill real values.
# NEVER put real secrets in this file (C7).

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=jeyvro
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Payments (Phase 9) — COD needs nothing; the online seam stays unset until
# a real gateway lands. Sandbox turns on the fake checkout for testing only.
PAYMENTS_PAYMENT_EXPIRY_HOURS=24
PAYMENTS_GATEWAY_WEBHOOK_SECRET=
PAYMENTS_GATEWAY_CHECKOUT_URL=
PAYMENTS_GATEWAY_SANDBOX=False
